{
    "name": "youtube-to-mp3",
    "productName": "YouTube To MP3",
    "version": "2.0.0",
    "description": "Desktop app that converts YouTube videos to MP3 on your own computer",
    "author": {
        "name": "Victor Williams",
        "email": "victor.williams.dev@gmail.com"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vaporjawn/Youtube-to-MP3",
    "main": "electron/main.js",
    "scripts": {
        "start": "vite build && electron .",
        "build": "vite build",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "binaries": "node scripts/fetch-binaries.mjs",
        "dist:mac": "node scripts/dist.mjs mac",
        "dist:win": "node scripts/dist.mjs win",
        "dist:linux": "node scripts/dist.mjs linux",
        "dist": "node scripts/dist.mjs all",
        "prettier": "prettier --write \"**/*.{html,js,jsx,mjs,json,md,yml}\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Vaporjawn/Youtube-to-MP3.git"
    },
    "keywords": [
        "electron",
        "react",
        "youtube",
        "mp3",
        "yt-dlp",
        "vaporjawn"
    ],
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@vitejs/plugin-react": "6.1.2",
        "electron": "44.9.0",
        "electron-builder": "26.15.3",
        "fflate": "^0.8.3",
        "prettier": "3.9.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sass": "1.105.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    }
}
